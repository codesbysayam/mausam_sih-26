# ====================================================================
# MAUSAM — environment variables
# All credentials are server-side only. Never prefix secrets with VITE_.
# Core weather and basic map rendering work without optional credentials.
# ====================================================================

# Assistant: optional. "auto" uses the remote endpoint when URL is present;
# otherwise it uses a grounded local telemetry summary.
MAUSAM_ASSISTANT_MODE=auto
MAUSAM_ASSISTANT_API_URL=
MAUSAM_ASSISTANT_API_KEY=
# Required by providers that do not supply a default model.
MAUSAM_ASSISTANT_MODEL=

# Shared Upstash Redis REST cache: optional; configure BOTH values together.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Durable PostgreSQL persistence: optional; use a provider-issued connection string.
DATABASE_URL=
# Alternative accepted by the current database service:
POSTGRES_URL=

# Official IMD integration: optional and only usable with credentials and
# an endpoint/access entitlement issued to your deployment.
IMD_API_ENABLED=false
IMD_API_BASE_URL=
IMD_API_KEY=
IMD_API_TOKEN=

# Optional CPCB integration. A key alone does not prove the feed is reachable.
CPCB_API_KEY=

# Runtime metadata (normally supplied by deployment/CI).
NODE_ENV=development
APP_BUILD_ID=
GIT_COMMIT_SHA=
