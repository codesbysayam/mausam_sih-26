# ==========================================================
# MAUSAM — DEFAULT KEYLESS CONFIGURATION
# No API keys required for core weather, maps, radar, or local assistant.
# All private credentials below are server-side only (never prefix with VITE_).
# ==========================================================

MAUSAM_ASSISTANT_MODE=local

# Optional remote Gemini integration.
# Leave blank when using local mode. Set MAUSAM_ASSISTANT_MODE=remote to opt in.
MAUSAM_ASSISTANT_API_URL=
MAUSAM_ASSISTANT_API_KEY=
MAUSAM_ASSISTANT_MODEL=gemini-3.8-flash

# Optional Shared Cache / Persistence Integrations:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DATABASE_URL=

# Optional Official IMD API Gateway Integration:
# Leave IMD_API_ENABLED=false unless an authorized IMD endpoint and credentials are issued.
IMD_API_BASE_URL=
IMD_API_KEY=
IMD_API_TOKEN=
IMD_API_ENABLED=false

# Optional external data providers (leave blank unless issued)
CPCB_API_KEY=
INCOIS_API_KEY=
ACCUWEATHER_API_KEY=
GOOGLE_WEATHER_API_KEY=
